; dot-entity — the id space every world object shares.
;
; The distributable is `addons/dot_entity/`. This project exists so the addon can
; be opened and validated standalone.
;
; `addons/dot_core/` is a LOCAL SYMLINK to its own repository and is gitignored.
; See CLAUDE.md.

config_version=5

[application]

config/name="dot-entity"
config/description="An allocator for entity ids that carry their own kind, a record kept beside the node rather than on it, and the node and key reverse indexes every game was maintaining by hand."
config/version="0.1.0"
run/main_scene="res://examples/entity_selftest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_core/plugin.cfg", "res://addons/dot_entity/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
